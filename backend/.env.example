NVIDIA_API_KEY=your-key-here
# Exact model ID from https://build.nvidia.com/models (NIM catalog). Example format:
# MODEL=meta/llama-3.1-8b-instruct -- check the site for current IDs, do not guess.
MODEL=put-exact-model-id-from-build-nvidia-here
ALLOWED_ORIGINS=https://MYDOMAIN.com
RATE_PER_MINUTE=6
RATE_PER_DAY=40
GLOBAL_DAILY_LIMIT=500
